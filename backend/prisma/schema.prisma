generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "sqlite"
  url = env("DATABASE_URL")
}
model Article {
  id String @id @default(cuid())
  fingerprint String @unique
  title String
  content String
  source String
  url String
  canonicalUrl String
  publishedAt DateTime
  language String
  primarySourceId String?
  normalizedText String
  originalJson String
  createdAt DateTime @default(now())
  runs ProcessingRun[]
  claims ExtractedClaim[]
  canonicalSources CanonicalEventSource[]
  contentFingerprint String @default("")
  originalSource String?
  syndicationSource String?
  primaryDocument String?
  lineageId String?
  evidence Evidence[]
  sources EventSource[]
}
model ProcessingRun {
  id String @id @default(cuid())
  articleId String
  article Article @relation(fields: [articleId], references: [id])
  model String
  promptVersion String
  attempt Int @default(0)
  retryOf String?
  status String @default("processing")
  rawOutput String?
  warnings String @default("[]")
  error String?
  durationMs Int @default(0)
  createdAt DateTime @default(now())
  finishedAt DateTime?
  events Event[]
  claims ExtractedClaim[]
  reviewReasons String @default("[]")
  requests LlmRequest[]
  @@index([articleId, createdAt])
  @@unique([articleId, model, promptVersion, attempt])
}
model Event {
  id String @id @default(cuid())
  runId String
  run ProcessingRun @relation(fields: [runId], references: [id])
  title String
  summary String
  eventType String
  eventStatus String
  occurredAt DateTime?
  publishedAt DateTime
  verificationStatus String @default("Unverified")
  publicationStatus String @default("NeedsReview")
  confidence Float
  warnings String
  duplicateCandidates String @default("[]")
  createdAt DateTime @default(now())
  participants EventParticipant[]
  relationships Relationship[]
  evidence Evidence[]
  sources EventSource[]
  decisions ReviewDecision[]
  @@index([eventType, publishedAt])
  @@index([publicationStatus, verificationStatus])
}
model EventParticipant {
  id String @id @default(cuid())
  eventId String
  event Event @relation(fields: [eventId], references: [id])
  countryCode String
  role String
  @@unique([eventId, countryCode])
  @@index([countryCode])
}
model Relationship {
  id String @id @default(cuid())
  eventId String
  event Event @relation(fields: [eventId], references: [id])
  sourceCountry String
  targetCountry String
  type String
  direction String
  confidence Float
  evidenceRefs String
  @@index([sourceCountry, targetCountry, type])
}
model Evidence {
  id String @id @default(cuid())
  eventId String
  event Event @relation(fields: [eventId], references: [id])
  articleId String
  article Article @relation(fields: [articleId], references: [id])
  ordinal Int
  text String
  startOffset Int
  endOffset Int
  @@unique([eventId, ordinal])
}
model EventSource {
  id String @id @default(cuid())
  eventId String
  event Event @relation(fields: [eventId], references: [id])
  articleId String
  article Article @relation(fields: [articleId], references: [id])
  @@unique([eventId, articleId])
}
model ReviewDecision {
  id String @id @default(cuid())
  eventId String
  event Event @relation(fields: [eventId], references: [id])
  reviewer String
  decision String
  note String
  createdAt DateTime @default(now())
}
model LlmRequest {
  id String @id @default(cuid())
  runId String
  run ProcessingRun @relation(fields: [runId], references: [id])
  model String
  month String
  status String @default("reserved")
  inputTokens Int @default(0)
  outputTokens Int @default(0)
  estimatedCostUsd Float
  inputRate Float
  outputRate Float
  pricingVerifiedAt String
  durationMs Int @default(0)
  createdAt DateTime @default(now())
  @@index([month, status])
}
model ExtractedClaim {
  id String @id @default(cuid())
  legacyEventId String? @unique
  runId String
  run ProcessingRun @relation(fields:[runId], references:[id])
  articleId String
  article Article @relation(fields:[articleId], references:[id])
  canonicalEventId String?
  canonicalEvent CanonicalEvent? @relation(fields:[canonicalEventId], references:[id])
  title String
  summary String
  eventType String
  eventStatus String
  actionText String
  objectText String?
  occurredAt DateTime?
  publishedAt DateTime
  confidence Float
  rawClaim String
  entities String @default("[]")
  validationStatus String
  verificationStatus String @default("NotAssessed")
  publicationStatus String
  validationResults String
  reviewReasons String @default("[]")
  createdAt DateTime @default(now())
  participants ClaimParticipant[]
  evidence ClaimEvidence[]
  relationships ClaimRelationship[]
  sources CanonicalEventSource[]
  validationHistory ClaimValidationDecision[]
  mergeCandidates MergeCandidate[]
  @@index([validationStatus, publicationStatus])
  @@index([articleId, runId])
}
model ClaimParticipant {
  id String @id @default(cuid())
  claimId String
  claim ExtractedClaim @relation(fields:[claimId], references:[id])
  countryCode String
  role String
  attributionEvidenceIds String
  @@unique([claimId,countryCode])
}
model ClaimEvidence {
  id String @id @default(cuid())
  claimId String
  claim ExtractedClaim @relation(fields:[claimId], references:[id])
  temporaryId String
  text String
  kind String
  startOffset Int
  endOffset Int
  quoteMatch String
  semanticSupport String @default("NotAssessed")
  sourceVerification String @default("NotAssessed")
  links ClaimEvidenceLink[]
  @@unique([claimId,temporaryId])
}
model ClaimRelationship {
  id String @id @default(cuid())
  claimId String
  claim ExtractedClaim @relation(fields:[claimId], references:[id])
  sourceCountry String
  targetCountry String
  type String
  direction String
  confidence Float
  evidenceIds String
  referenceIntegrity String
  evidence ClaimEvidenceLink[]
}
model ClaimEvidenceLink {
  relationshipId String
  relationship ClaimRelationship @relation(fields:[relationshipId], references:[id])
  evidenceId String
  evidence ClaimEvidence @relation(fields:[evidenceId], references:[id])
  @@id([relationshipId,evidenceId])
}
model CanonicalEvent {
  id String @id @default(cuid())
  title String
  normalizedTitle String
  summary String
  eventType String
  eventStatus String
  actionKey String
  objectKey String
  occurredAt DateTime?
  publishedAt DateTime
  verificationStatus String @default("Unverified")
  publicationStatus String @default("NeedsReview")
  archived Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  claims ExtractedClaim[]
  participants CanonicalParticipant[]
  relationships EventRelationship[]
  sources CanonicalEventSource[]
  mergeCandidates MergeCandidate[]
  revisions EventRevision[]
  verificationDecisions VerificationDecision[]
  @@index([eventType,eventStatus,publishedAt])
}
model CanonicalParticipant {
  id String @id @default(cuid())
  canonicalEventId String
  canonicalEvent CanonicalEvent @relation(fields:[canonicalEventId], references:[id])
  countryCode String
  role String
  @@unique([canonicalEventId,countryCode])
}
model EventRelationship {
  id String @id @default(cuid())
  canonicalEventId String
  canonicalEvent CanonicalEvent @relation(fields:[canonicalEventId], references:[id])
  originClaimId String
  sourceCountry String
  targetCountry String
  type String
  direction String
  evidenceIds String
}
model CanonicalEventSource {
  id String @id @default(cuid())
  canonicalEventId String
  canonicalEvent CanonicalEvent @relation(fields:[canonicalEventId], references:[id])
  claimId String
  claim ExtractedClaim @relation(fields:[claimId], references:[id])
  articleId String
  article Article @relation(fields:[articleId], references:[id])
  active Boolean @default(true)
  publisher String
  originalSource String?
  syndicationSource String?
  primaryDocument String?
  lineageId String?
  independenceStatus String @default("Unknown")
  linkReason String
  createdAt DateTime @default(now())
  @@unique([canonicalEventId,claimId])
}
model MergeCandidate {
  id String @id @default(cuid())
  claimId String
  claim ExtractedClaim @relation(fields:[claimId], references:[id])
  canonicalEventId String
  canonicalEvent CanonicalEvent @relation(fields:[canonicalEventId], references:[id])
  score Float
  reasons String
  status String @default("Pending")
  reviewer String?
  decisionNote String?
  decidedAt DateTime?
  createdAt DateTime @default(now())
  @@unique([claimId,canonicalEventId])
}
model EventRevision {
  id String @id @default(cuid())
  canonicalEventId String
  canonicalEvent CanonicalEvent @relation(fields:[canonicalEventId], references:[id])
  actor String
  reason String
  beforeJson String
  afterJson String
  createdAt DateTime @default(now())
}
model VerificationDecision {
  id String @id @default(cuid())
  canonicalEventId String
  canonicalEvent CanonicalEvent @relation(fields:[canonicalEventId], references:[id])
  assessor String
  method String
  outcome String
  sourceIndependence String
  evidence String
  reason String
  createdAt DateTime @default(now())
}
model ClaimValidationDecision {
 id String @id @default(cuid())
 claimId String
 claim ExtractedClaim @relation(fields:[claimId], references:[id])
 validatorVersion String
 previousStatus String
 nextStatus String
 beforeJson String
 afterJson String
 reasons String
 createdAt DateTime @default(now())
 @@unique([claimId,validatorVersion])
}

// Legacy intelligence tables above are retained read-only for historical data.
model CollectedArticle {
 id String @id @default(cuid())
 source String
 sourceUrl String
 sourceArticleId String?
 url String @unique
 title String
 publishedAt DateTime?
 collectedAt DateTime @default(now())
 author String?
 language String
 content String
 contentStatus String
 contentHash String
 originalJson String
 analysisStatus String @default("collected")
 analyzedAt DateTime?
 analysisBatchId String?
 analysisVersion Int @default(0)
 analysisResultId String?
 memberships BatchArticle[]
 reservation BatchReservation?
 eventSources ImportedEventSource[]
 @@unique([source,sourceArticleId])
 @@index([analysisStatus,collectedAt])
 @@index([source,contentHash])
}
model NewsBatch {
 id String @id @default(cuid())
 schemaVersion String @default("1.0")
 createdAt DateTime @default(now())
 status String @default("active")
 exportJson String
 exportedAt DateTime?
 importedAt DateTime?
 importChecksum String?
 importVersion Int @default(0)
 articles BatchArticle[]
 reservations BatchReservation[]
 analyses AnalysisImport[]
 events ImportedEvent[]
}
model BatchArticle {
 batchId String
 batch NewsBatch @relation(fields:[batchId],references:[id])
 articleId String
 article CollectedArticle @relation(fields:[articleId],references:[id])
 ordinal Int
 @@id([batchId,articleId])
 @@unique([batchId,ordinal])
}
model BatchReservation {
 articleId String @id
 article CollectedArticle @relation(fields:[articleId],references:[id])
 batchId String
 batch NewsBatch @relation(fields:[batchId],references:[id])
}
model AnalysisImport {
 id String @id @default(cuid())
 batchId String
 batch NewsBatch @relation(fields:[batchId],references:[id])
 version Int
 checksum String
 rawJson String
 createdAt DateTime @default(now())
 events ImportedEvent[]
 @@unique([batchId,version])
}
model ImportedEvent {
 id String @id @default(cuid())
 batchId String
 batch NewsBatch @relation(fields:[batchId],references:[id])
 articleId String
 eventKey String
 analysisId String
 analysis AnalysisImport @relation(fields:[analysisId],references:[id])
 title String
 summary String
 eventType String
 eventStatus String
 reason String?
 publishedAt DateTime?
 verificationStatus String @default("Unverified")
 publicationStatus String
 archived Boolean @default(false)
 participantsJson String
 rawJson String
 relationships ImportedRelationship[]
 sources ImportedEventSource[]
 @@unique([batchId,articleId,eventKey])
}
model ImportedRelationship {
 id String @id @default(cuid())
 eventId String
 event ImportedEvent @relation(fields:[eventId],references:[id])
 from String
 to String
 type String
 direction String
}
model ImportedEventSource {
 eventId String
 event ImportedEvent @relation(fields:[eventId],references:[id])
 articleId String
 article CollectedArticle @relation(fields:[articleId],references:[id])
 @@id([eventId,articleId])
}
