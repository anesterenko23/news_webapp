MISTRAL_API_KEY=
MISTRAL_MODEL=ministral-8b-2512
# Phase 4.7 candidate template only; copying this opts into Gemini.
# Existing backend/.env and deployed provider settings are not changed.
LLM_PROVIDER=gemini
LLM_MAX_OUTPUT_TOKENS=8000
LLM_TIMEOUT_MS=60000
LLM_MAX_RETRIES=2
LLM_MONTHLY_BUDGET_USD=10
# Official standard rates, USD per million tokens; recheck at least every 30 days.
LLM_INPUT_USD_PER_MILLION=0.15
LLM_OUTPUT_USD_PER_MILLION=0.15
LLM_PRICING_VERIFIED_AT=2026-10-18
DATABASE_URL=file:./dev.db
HOST=127.0.0.1
PORT=3001
NODE_ENV=development
# Required in production or when binding beyond loopback; at least 32 characters.
ADMIN_API_TOKEN=

# Gemini is the Phase 4.7 candidate; set LLM_PROVIDER=mistral for the alternative.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Gemini rates are separate from Mistral; standard Oct 18, 2026 rates.
GEMINI_INPUT_USD_PER_MILLION=0.75
GEMINI_OUTPUT_USD_PER_MILLION=3.75
GEMINI_PRICING_VERIFIED_AT=2026-10-18
