{
  "name": "world-lens",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "assets": "node scripts/prepare-assets.mjs",
    "postinstall": "npm run db:generate && npm run assets",
    "predev": "npm run assets",
    "prebuild": "npm run assets",
    "test": "vitest run",
    "backend:dev": "node backend/dev.mjs",
    "backend:start": "npm run backend:build && node backend/dist/server.js",
    "backend:build": "tsc -p backend/tsconfig.json",
    "db:generate": "prisma generate --schema backend/prisma/schema.prisma",
    "db:migrate": "node backend/migrate.mjs",
    "test:backend": "vitest run --config backend/vitest.config.ts --configLoader runner",
    "ai:evaluate": "node --experimental-strip-types backend/evaluate.mjs"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@react-three/drei": "^10.7.0",
    "@react-three/fiber": "^9.3.0",
    "@react-three/postprocessing": "^3.2.0",
    "dotenv": "^18.0.8",
    "fastify": "^5.12.7",
    "postprocessing": "^6.39.5",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "three": "^0.180.0",
    "three-stdlib": "^2.36.1",
    "topojson-client": "^3.1.0",
    "zod": "^4.6.7",
    "world-countries": "^5.1.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@types/three": "^0.180.0",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-specification": "^1.0.5",
    "@vitejs/plugin-react": "^5.0.4",
    "prisma": "^6.19.3",
    "typescript": "~5.9.3",
    "vite": "^7.1.9",
    "vitest": "^5.0.5",
    "world-atlas": "^2.0.2"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.0"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
